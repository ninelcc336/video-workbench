{
  "name": "local-video-effect-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:all": "concurrently -k \"npm run dev:server\" \"npm run dev -- --host 127.0.0.1\"",
    "test": "vitest run src",
    "test:render-smoke": "tsx scripts/render-smoke.ts",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-select": "^2.3.4",
    "@remotion/bundler": "^4.0.490",
    "@remotion/player": "latest",
    "@remotion/renderer": "latest",
    "@types/multer": "^2.2.0",
    "express": "latest",
    "multer": "^2.2.0",
    "react": "latest",
    "react-dom": "latest",
    "remotion": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
